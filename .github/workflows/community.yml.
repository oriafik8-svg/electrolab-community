name: Community
# One file does both jobs: it checks every shared item (on pull requests and on main) and rebuilds index.json after a change to main.
on:
  push:
    branches: [main]
    paths: ['items/**']
  pull_request:
    paths: ['items/**']
  workflow_dispatch:
permissions:
  contents: write
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check the shared items
        run: |
          node - <<'EOF'
          const fs = require('fs'), path = require('path');
          const dir0 = 'items', ALLOWED = new Set(['.stl', '.3mf', '.json', '.ino', '.jpg', '.jpeg', '.png', '.md']), LICENSES = ['CC0-1.0', 'CC-BY-4.0', 'CC-BY-SA-4.0', 'MIT'], KINDS = ['model', 'circuit', 'both', 'skill'];
          const MAX = 25 * 1024 * 1024; let bad = 0; const fail = m => { console.error('::error::' + m); bad++; };
          for (const id of fs.existsSync(dir0) ? fs.readdirSync(dir0) : []) {
            const dir = path.join(dir0, id); if (!fs.statSync(dir).isDirectory()) continue;
            if (!/^[a-z0-9][a-z0-9-]{2,60}$/.test(id)) fail(id + ': the folder name must be lowercase letters, numbers and dashes');
            for (const f of fs.readdirSync(dir)) { const ext = path.extname(f).toLowerCase(); if (!ALLOWED.has(ext)) fail(id + '/' + f + ': this file type is not allowed'); if (fs.statSync(path.join(dir, f)).size > MAX) fail(id + '/' + f + ': bigger than 25 MB'); }
            const ij = path.join(dir, 'item.json'); if (!fs.existsSync(ij)) { fail(id + ': item.json is missing'); continue; }
            try {
              const j = JSON.parse(fs.readFileSync(ij, 'utf8').replace(/^﻿/, ''));
              if (!j.title) fail(id + ': no title');
              if (!KINDS.includes(j.kind)) fail(id + ': kind must be ' + KINDS.join(', '));
              if (!LICENSES.includes(j.license)) fail(id + ': license must be one of ' + LICENSES.join(', '));
              for (const f of j.files || []) if (!fs.existsSync(path.join(dir, f))) fail(id + ': listed file ' + f + ' is missing');
            } catch (e) { fail(id + ': item.json is not valid JSON'); }
          }
          if (bad) process.exit(1); console.log('all items look fine');
          EOF
  index:
    needs: check
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build index.json
        run: |
          node - <<'EOF'
          const fs = require('fs'), path = require('path'), out = [], dir0 = 'items';
          for (const id of fs.existsSync(dir0) ? fs.readdirSync(dir0) : []) {
            const f = path.join(dir0, id, 'item.json'); if (!fs.existsSync(f)) continue;
            try {
              const j = JSON.parse(fs.readFileSync(f, 'utf8').replace(/^﻿/, ''));
              const size = fs.readdirSync(path.join(dir0, id)).reduce((n, x) => n + fs.statSync(path.join(dir0, id, x)).size, 0);
              out.push({id, title: String(j.title || id).slice(0, 80), kind: j.kind || 'model', author: String(j.author || '').slice(0, 40), license: j.license || '', description: String(j.description || '').slice(0, 240), tags: (j.tags || []).slice(0, 8), created: j.created || '', files: j.files || [], size});
            } catch (e) { console.error('skipped', id, e.message); }
          }
          out.sort((a, b) => String(b.created).localeCompare(String(a.created)));
          fs.writeFileSync('index.json', JSON.stringify({version: 1, count: out.length, items: out}, null, 1) + '\n');
          console.log('index.json:', out.length, 'items');
          EOF
      - name: Commit the index
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add index.json
          git diff --staged --quiet || (git commit -m "Update index" && git push)
